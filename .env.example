# Copie este arquivo para .env e preencha a chave para ligar os recursos com IA no computador
# (análise de questões, correção de flashcards, Raio-X, leitura de imagens do Quadro, ajuste do plano).
# Sem chave, o app funciona normalmente e só esconde esses recursos.
# Com chave, rode "npm install" uma vez (instala o SDK da Anthropic) antes de "npm run dev".

# Claude (API da Anthropic): crie a chave em https://platform.claude.com
# A API é cobrada por uso, separada da assinatura do claude.ai.
ANTHROPIC_API_KEY=

# Modelos e esforço de cada nível que o app pede (opcional; estes são os padrões, veja ia/claude.mjs).
# Para gastar menos, troque o padrão para claude-sonnet-5-5.
AUDIS_MODELO_RAPIDO=claude-haiku-5-5
AUDIS_MODELO_PADRAO=claude-opus-5-5
AUDIS_MODELO_COMPLEXO=claude-opus-5-5
AUDIS_ESFORCO_RAPIDO=low
AUDIS_ESFORCO_PADRAO=medium
AUDIS_ESFORCO_COMPLEXO=high

# Alternativa: Gemini (Google AI Studio). Se as duas chaves existirem, AUDIS_IA escolhe: anthropic ou gemini.
# Com Gemini, os nomes de modelo acima precisam ser trocados por modelos do Gemini.
AUDIS_IA=
GEMINI_API_KEY=

# Voz da ElevenLabs para "Ouvir a teoria" (opcional; sem isto a leitura usa a voz do aparelho).
# A ElevenLabs cobra por caractere lido. Chave: elevenlabs.io > Developers > API Keys.
# Id da voz: em Voices, no menu da voz, "Copy voice ID".
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Só no Vercel (Settings > Environment Variables), além das chaves acima:
# AUDIS_SENHA=uma-senha-sua   (você digita no app, em "Dados neste aparelho", para liberar a IA)

# Porta do servidor local e pasta dos dados (opcional)
PORT=5173
AUDIS_DADOS=dados
