# Copie este arquivo para .env e preencha UMA das chaves para ligar os recursos com IA no modo local
# (análise de questões, correção de flashcards, leitura de imagens do Quadro, ajuste do plano etc.).
# Sem chave, o app funciona normalmente e só esconde esses recursos.

# Qual IA usar: anthropic ou gemini (se vazio, usa a que tiver chave)
AUDIS_IA=

# Claude (API da Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos (opcional). Confira os nomes atuais na documentação de cada API.
# O app pede três níveis: rápido (quick), padrão (default) e complexo (complex).
AUDIS_MODELO_RAPIDO=
AUDIS_MODELO_PADRAO=
AUDIS_MODELO_COMPLEXO=

# Porta do servidor local e pasta dos dados (opcional)
PORT=5173
AUDIS_DADOS=dados
